# ── RAGBot — Variáveis de Ambiente ──────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o Git
#
# cp .env.example .env

# ── Banco de Dados ───────────────────────────────────────────────────────────
POSTGRES_DB=ragbot
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_AGORA

# ── IA — Groq (LLM) ──────────────────────────────────────────────────────────
# Crie sua chave em: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── IA — Google (Embeddings) ─────────────────────────────────────────────────
# Crie sua chave em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# Gere um valor seguro: openssl rand -base64 32
JWT_SECRET=SUBSTITUA_POR_CHAVE_SEGURA_MINIMO_32_CARACTERES!!

# Troca a senha do usuário "admin" criado pela migration V3 (mín. 12 caracteres).
# Em prod o app NÃO sobe enquanto o admin usar a senha padrão do seed.
RAGBOT_ADMIN_PASSWORD=

# Origens extras liberadas no CORS, separadas por vírgula. Vazio = só a mesma origem.
ALLOWED_ORIGINS=

# Opcional: chave da NVD para o OWASP Dependency-Check (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
